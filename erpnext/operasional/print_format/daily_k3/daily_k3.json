ant;\" class=\"list-td\">\n                                <div>\n                                    <img src=\"/files/3_masker.jpeg\" style=\"width: 50px !important;\">\n                                </div>\n                                <span class=\"list-label\">\n                                    {% if doc.masker == 1 %}\n                                        &#x2610;\n                                    {% else %}\n                                        &#x2611;\n                                    {% endif %}\n                                </span>\n                            </td>\n                            <td style=\"width: 8% !important;\" class=\"list-td\">\n                                <div>\n                                    <img src=\"/files/4_respirator.jpeg\" style=\"width: 50px !important;\">\n                                </div>\n                                <span class=\"list-label\">\n                                    {% if doc.respirator == 1 %}\n                                        &#x2610;\n                                    {% else %}\n                                        &#x2611;\n                                    {% endif %}\n                                </span>\n                            </td>\n                            <td style=\"width: 8% !important;\" class=\"list-td\">\n                                <div>\n                                    <img src=\"/files/5_kedok_las.jpeg\" style=\"width: 50px !important;\">\n                                </div>\n                                <span class=\"list-label\">\n                                    {% if doc.kedok_las == 1 %}\n                                        &#x2610;\n                                    {% else %}\n                                        &#x2611;\n                                    {% endif %}\n                                </span>\n                            </td>\n                            <td style=\"width: 8